+//! Candidate 0009 — evidence provenance in both directions.
+//!
+//! Every test below pins one of the invariants the feature must not break.
+//! The weight tests matter most: provenance is audit, not belief. If citing
+//! three records moved `log_odds`, a well-documented observation would count
+//! more than a sparsely documented one, and the belief would answer to how
+//! much paper exists rather than to what was seen.
+
+use super::helpers::*;
+use super::YantrikDB;
+use crate::belief::{BeliefRevisionConfig, Evidence};
+use crate::engine::belief_sources::EvidenceCitation;
+use crate::state::NodeId;
+
+/// Deterministic embedder, so `correct(new_text=…)` can re-embed as the
+/// production path does. Without it the store has no embedder at all and a
+/// text correction fails with `NoEmbedder` — a property of the fixture, not of
+/// the feature under test.
+struct Dummy;
+
+impl crate::types::Embedder for Dummy {
+    fn embed(
+        &self,
+        _t: &str,
+    ) -> std::result::Result<Vec<f32>, Box<dyn std::error::Error + Send + Sync>> {
+        Ok(vec_seed(1.0, 8))
+    }
+
+    fn dim(&self) -> usize {
+        8
+    }
+}
+
+fn open_db() -> YantrikDB {
+    let mut db = YantrikDB::new(":memory:", 8).unwrap();
+    db.set_embedder(Box::new(Dummy)).unwrap();
+    db
+}
+
+fn record_in(db: &YantrikDB, text: &str, ns: &str) -> String {
+    db.record(
+        text,
+        "episodic",
+        0.8,
+        0.0,
+        1_000_000_000.0,
+        &serde_json::json!({}),
+        &vec_seed(1.0, 8),
+        ns,
+        0.8,
+        "work",
+        "observation",
+        None,
+    )
+    .unwrap()
+}
+
+fn belief(db: &YantrikDB, prop: &str) -> NodeId {
+    db.create_belief(prop, 0.0, "provenance", None, None)
+        .unwrap()
+        .id
+}
+
+fn evidence_on(id: NodeId, weight: f64, obs: &str) -> Evidence {
+    Evidence {
+        target_belief: id,
+        weight,
+        source: "test".into(),
+        provenance: crate::state::Provenance::Observed,
+        propagate: false,
+        timestamp: super::super::now(),
+        observation_id: Some(obs.to_string()),
+    }
+}
+
+fn cfg() -> BeliefRevisionConfig {
+    BeliefRevisionConfig::default()
+}
+
+fn probability(db: &YantrikDB, id: NodeId) -> f64 {
+    db.load_cognitive_node(id).unwrap().unwrap().attrs.confidence
+}
+
+// ── 1. Forward: several records under ONE observation ────────────────
+
+#[test]
+fn one_observation_can_cite_several_records() {
+    let db = open_db();
+    let b = belief(&db, "The endpoint is v2");
+    let m1 = record_in(&db, "Measurement: 194 methods on api2", "a");
+    let m2 = record_in(&db, "Manifest: build api2 from d32f219", "a");
+
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(b, 2.0, "obs-1"),
+        &[
+            EvidenceCitation { rid: m1.clone(), revision: None },
+            EvidenceCitation { rid: m2.clone(), revision: None },
+        ],
+        &cfg(),
+    )
+    .unwrap()
+    .unwrap();
+
+    let rows = db.belief_sources(b, None, None).unwrap();
+    assert_eq!(rows.len(), 2, "both records are cited, under one observation");
+    assert!(rows.iter().all(|r| r.observation_id == "obs-1"));
+    assert!(rows.iter().all(|r| r.source_state == "live"));
+
+    // The belief keeps ONE evidence entry: several citations are not votes.
+    let node = db.load_cognitive_node(b).unwrap().unwrap();
+    let crate::state::NodePayload::Belief(p) = &node.payload else { panic!() };
+    assert_eq!(p.evidence_trail.len(), 1);
+}
+
+// ── 2. Provenance is not weight ──────────────────────────────────────
+
+#[test]
+fn citing_more_sources_does_not_change_confidence() {
+    let db = open_db();
+    let one = belief(&db, "with one source");
+    let three = belief(&db, "with three sources");
+    let r = record_in(&db, "single record", "a");
+    let r2 = record_in(&db, "second record", "a");
+    let r3 = record_in(&db, "third record", "a");
+
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(one, 1.5, "obs-a"),
+        &[EvidenceCitation { rid: r.clone(), revision: None }],
+        &cfg(),
+    )
+    .unwrap();
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(three, 1.5, "obs-b"),
+        &[
+            EvidenceCitation { rid: r.clone(), revision: None },
+            EvidenceCitation { rid: r2, revision: None },
+            EvidenceCitation { rid: r3, revision: None },
+        ],
+        &cfg(),
+    )
+    .unwrap();
+
+    assert!(
+        (probability(&db, one) - probability(&db, three)).abs() < 1e-12,
+        "one observation with three citations must weigh exactly as much as \
+         the same observation with one: {} vs {}",
+        probability(&db, one),
+        probability(&db, three)
+    );
+}
+
+// ── 3. Reverse: several beliefs on ONE record ────────────────────────
+
+#[test]
+fn one_source_can_carry_several_beliefs() {
+    let db = open_db();
+    let b1 = belief(&db, "api2 has a belief API");
+    let b2 = belief(&db, "api2 is the later candidate");
+    let m = record_in(&db, "194 methods on api2", "a");
+
+    for (b, obs) in [(b1, "obs-1"), (b2, "obs-2")] {
+        db.assert_belief_evidence_with_sources(
+            &evidence_on(b, 1.0, obs),
+            &[EvidenceCitation { rid: m.clone(), revision: None }],
+            &cfg(),
+        )
+        .unwrap();
+    }
+
+    let rows = db.beliefs_for_source(&m, None).unwrap();
+    assert_eq!(rows.len(), 2);
+    let ids: Vec<i64> = rows.iter().map(|r| r.belief_id).collect();
+    assert!(ids.contains(&(b1.to_raw() as i64)) && ids.contains(&(b2.to_raw() as i64)));
+    assert!(rows.iter().all(|r| r.proposition.contains("api2")));
+}
+
+// ── 4. A later correction does not rewrite the citation ──────────────
+
+#[test]
+fn record_correction_marks_drift_without_touching_the_belief() {
+    let db = open_db();
+    let b = belief(&db, "the count is 194");
+    let m = record_in(&db, "Method count: 194", "a");
+
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(b, 2.0, "obs-1"),
+        &[EvidenceCitation { rid: m.clone(), revision: None }],
+        &cfg(),
+    )
+    .unwrap();
+    let before = probability(&db, b);
+
+    db.correct(&m, Some("Method count: 180 (corrected)"), None, None, None, "recount")
+        .unwrap();
+
+    let rows = db.belief_sources(b, None, None).unwrap();
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].source_revision, 0, "cited revision stays the original");
+    assert_eq!(rows[0].current_revision, 1, "the record moved on");
+    assert!(rows[0].revision_drift, "drift is the signal to review");
+    assert_eq!(rows[0].source_state, "live", "a correction is not a retraction");
+
+    assert!(
+        (probability(&db, b) - before).abs() < 1e-12,
+        "a corrected source flags review; it does not move confidence by itself"
+    );
+}
+
+/// An explicit revision is honoured and stays that number.
+#[test]
+fn explicit_cited_revision_is_kept() {
+    let db = open_db();
+    let b = belief(&db, "pinned to revision two");
+    let m = record_in(&db, "v0", "a");
+    for i in 1..=3 {
+        db.correct(&m, Some(&format!("v{i}")), None, None, None, "edit").unwrap();
+    }
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(b, 1.0, "obs-pinned"),
+        &[EvidenceCitation { rid: m.clone(), revision: Some(2) }],
+        &cfg(),
+    )
+    .unwrap();
+
+    let rows = db.belief_sources(b, None, None).unwrap();
+    assert_eq!(rows[0].source_revision, 2);
+    assert_eq!(rows[0].current_revision, 3);
+    assert!(rows[0].revision_drift);
+}
+
+// ── 5. Retraction keeps the dependency visible ───────────────────────
+
+#[test]
+fn retracted_source_stays_traceable_and_does_not_lower_confidence() {
+    let db = open_db();
+    let b = belief(&db, "the endpoint is v2");
+    let m = record_in(&db, "api2 measurement", "a");
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(b, 2.0, "obs-1"),
+        &[EvidenceCitation { rid: m.clone(), revision: None }],
+        &cfg(),
+    )
+    .unwrap();
+    let before = probability(&db, b);
+
+    db.forget(&m).unwrap();
+
+    let fwd = db.belief_sources(b, None, None).unwrap();
+    assert_eq!(fwd.len(), 1);
+    assert_eq!(fwd[0].source_state, "retracted");
+
+    let rev = db.beliefs_for_source(&m, None).unwrap();
+    assert_eq!(rev.len(), 1, "a withdrawn record must not become invisible");
+    assert_eq!(rev[0].source_state, "retracted");
+
+    assert!(
+        (probability(&db, b) - before).abs() < 1e-12,
+        "withdrawn source = review needed, not refuted"
+    );
+}
+
+// ── 6. Idempotency ───────────────────────────────────────────────────
+
+#[test]
+fn citing_the_same_source_twice_is_idempotent() {
+    let db = open_db();
+    let b = belief(&db, "stable");
+    let m = record_in(&db, "one record", "a");
+
+    for _ in 0..3 {
+        db.assert_belief_evidence_with_sources(
+            &evidence_on(b, 1.0, "obs-same"),
+            &[EvidenceCitation { rid: m.clone(), revision: None }],
+            &cfg(),
+        )
+        .unwrap();
+    }
+
+    let rows = db.belief_sources(b, None, None).unwrap();
+    assert_eq!(rows.len(), 1, "same (belief, observation, record) = one row");
+    // And the evidence entry was revised, not duplicated (0004).
+    let node = db.load_cognitive_node(b).unwrap().unwrap();
+    let crate::state::NodePayload::Belief(p) = &node.payload else { panic!() };
+    assert_eq!(p.evidence_trail.len(), 1);
+}
+
+// ── 7. Unknown source is rejected before anything is written ─────────
+
+#[test]
+fn unknown_source_is_rejected_and_writes_nothing() {
+    let db = open_db();
+    let b = belief(&db, "unchanged");
+    let m = record_in(&db, "real record", "a");
+    let before = probability(&db, b);
+
+    let err = db.assert_belief_evidence_with_sources(
+        &evidence_on(b, 3.0, "obs-bad"),
+        &[
+            EvidenceCitation { rid: m.clone(), revision: None },
+            EvidenceCitation { rid: "does-not-exist".into(), revision: None },
+        ],
+        &cfg(),
+    );
+    assert!(err.is_err(), "a citation must point at a record that existed");
+
+    assert!((probability(&db, b) - before).abs() < 1e-12, "no partial write");
+    assert!(db.belief_sources(b, None, None).unwrap().is_empty());
+    let node = db.load_cognitive_node(b).unwrap().unwrap();
+    let crate::state::NodePayload::Belief(p) = &node.payload else { panic!() };
+    assert!(p.evidence_trail.is_empty());
+}
+
+/// Sources without an observation id cannot be attached to anything.
+#[test]
+fn sources_require_an_observation_id() {
+    let db = open_db();
+    let b = belief(&db, "needs an identity");
+    let m = record_in(&db, "record", "a");
+    let mut ev = evidence_on(b, 1.0, "unused");
+    ev.observation_id = None;
+
+    let err = db.assert_belief_evidence_with_sources(
+        &ev,
+        &[EvidenceCitation { rid: m, revision: None }],
+        &cfg(),
+    );
+    assert!(err.is_err());
+    assert!(db.belief_sources(b, None, None).unwrap().is_empty());
+}
+
+// ── 8. Namespace isolation ───────────────────────────────────────────
+
+#[test]
+fn reverse_lookup_can_be_scoped_to_the_citation_namespace() {
+    let db = open_db();
+    let b1 = belief(&db, "belief in a");
+    let b2 = belief(&db, "belief in b");
+    let ma = record_in(&db, "record in a", "ns-a");
+    let mb = record_in(&db, "record in b", "ns-b");
+
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(b1, 1.0, "obs-a"),
+        &[EvidenceCitation { rid: ma.clone(), revision: None }],
+        &cfg(),
+    )
+    .unwrap();
+    db.assert_belief_evidence_with_sources(
+        &evidence_on(b2, 1.0, "obs-b"),
+        &[EvidenceCitation { rid: mb.clone(), revision: None }],
+        &cfg(),
+    )
+    .unwrap();
+
+    assert_eq!(db.beliefs_for_source(&ma, Some("ns-a")).unwrap().len(), 1);
+    assert!(db.beliefs_for_source(&ma, Some("ns-b")).unwrap().is_empty(),
+            "a namespace-scoped lookup must not leak the other namespace");
+    assert_eq!(db.beliefs_for_source(&ma, None).unwrap().len(), 1);
+    assert_eq!(db.belief_sources(b1, None, Some("ns-a")).unwrap().len(), 1);
+    assert!(db.belief_sources(b1, None, Some("ns-b")).unwrap().is_empty());
+}
