+    let p1 = probability(&db, b);
+
+    let second = db
+        .assert_belief_evidence_with_sources(
+            &evidence_on(b, 1.0, "obs-2"),
+            &[EvidenceCitation { rid: m2, revision: None }],
+            &cfg(),
+        )
+        .unwrap()
+        .unwrap();
+    assert_eq!(second.folded_into_observation, None);
+    assert!(
+        probability(&db, b) > p1,
+        "an independent record is independent evidence"
+    );
+    let node = db.load_cognitive_node(b).unwrap().unwrap();
+    let crate::state::NodePayload::Belief(p) = &node.payload else { panic!() };
+    assert_eq!(p.evidence_trail.len(), 2);
+}
