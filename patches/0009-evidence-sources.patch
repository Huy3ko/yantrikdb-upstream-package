index 8625488..2eb9b6a 100644
--- a/crates/yantrikdb-core/src/base/schema.rs
+++ b/crates/yantrikdb-core/src/base/schema.rs
@@ -1644,6 +1644,34 @@ CREATE TABLE IF NOT EXISTS cognitive_edges (
 CREATE INDEX IF NOT EXISTS idx_cognitive_edges_dst ON cognitive_edges(dst_id);
 CREATE INDEX IF NOT EXISTS idx_cognitive_edges_kind ON cognitive_edges(kind);
 
+-- Belief evidence sources (candidate 0009): which records — and which revision
+-- of each — an observation rests on. Normalised on purpose: one row per
+-- (belief, observation, record) carries its own revision number, so there are
+-- no parallel rid/rev vectors that can drift apart. `observation_id` is the
+-- stable identity of the observation (0004); several rows under one
+-- observation are several citations of ONE observation, never extra votes —
+-- the evidence weight lives in the belief payload and is not derived from
+-- here. `source_revision` is the record's revision AT CITATION TIME (0 =
+-- original): a later `correct()` bumps the record's revision and leaves this
+-- row alone, which is what makes the original provenance survive a
+-- correction. Rows are never deleted by `forget()`: a retracted source stays
+-- traceable so a dependent belief can be found and reviewed.
+CREATE TABLE IF NOT EXISTS belief_evidence_sources (
+    belief_id       INTEGER NOT NULL,
+    observation_id  TEXT    NOT NULL,
+    source_rid      TEXT    NOT NULL,
+    source_revision INTEGER NOT NULL DEFAULT 0,
+    namespace       TEXT    NOT NULL DEFAULT 'default',
+    created_at      REAL    NOT NULL,
+    hlc             BLOB,
+    origin_actor    TEXT    NOT NULL,
+    PRIMARY KEY (belief_id, observation_id, source_rid)
+);
+CREATE INDEX IF NOT EXISTS idx_bes_belief
+    ON belief_evidence_sources(belief_id, observation_id);
+CREATE INDEX IF NOT EXISTS idx_bes_source
+    ON belief_evidence_sources(namespace, source_rid, belief_id);
+
 -- High-water marks for NodeId allocator (V12)
