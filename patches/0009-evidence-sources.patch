+// ── 11. Eine neue Revision ist keine neue Beobachtung ────────────────
+
+/// A corrected record, re-cited under a fresh observation id, must not vote
+/// again: the observation is the experience, not the revision.
+#[test]
+fn re_citing_a_corrected_record_does_not_vote_twice() {
+    let db = open_db();
+    let b = belief(&db, "the count is 194");
+    let m = record_in(&db, "Method count: 194", "a");
+
+    let first = db
+        .assert_belief_evidence_with_sources(
+            &evidence_on(b, 2.0, "obs-1"),
+            &[EvidenceCitation { rid: m.clone(), revision: None }],
+            &cfg(),
+        )
+        .unwrap()
+        .unwrap();
+    assert_eq!(first.folded_into_observation, None);
+    let p1 = probability(&db, b);
+
+    // The record is corrected (typo). A fresh observation id arrives.
+    db.correct(&m, Some("Method count: 194 (typo fixed)"), None, None, None, "typo")
+        .unwrap();
+    let second = db
+        .assert_belief_evidence_with_sources(
+            &evidence_on(b, 2.0, "obs-2"),
+            &[EvidenceCitation { rid: m.clone(), revision: None }],
+            &cfg(),
+        )
+        .unwrap()
+        .unwrap();
+
+    assert_eq!(
+        second.folded_into_observation.as_deref(),
+        Some("obs-1"),
+        "the call must report which observation it landed in"
+    );
+    assert!(
+        (probability(&db, b) - p1).abs() < 1e-12,
+        "a typo fix in a source must not double the confidence ({} -> {})",
+        p1,
+        probability(&db, b)
+    );
+
+    let node = db.load_cognitive_node(b).unwrap().unwrap();
+    let crate::state::NodePayload::Belief(p) = &node.payload else { panic!() };
+    assert_eq!(p.evidence_trail.len(), 1, "still one observation");
+
+    let rows = db.belief_sources(b, None, None).unwrap();
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].observation_id, "obs-1", "citation stays where it was made");
+    assert_eq!(rows[0].source_revision, 0, "and keeps the cited revision");
+}
