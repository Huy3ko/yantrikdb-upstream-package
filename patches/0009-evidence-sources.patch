+    /// Forward: which records does this belief rest on? Oldest citation first.
+    /// Each row carries the cited revision, the record's current revision, a
+    /// `revision_drift` flag and the source's state
+    /// (`live` | `superseded` | `retracted` | `missing`) — none of which
+    /// changes the belief's confidence.
+    #[pyo3(signature = (node_id, observation_id=None, namespace=None))]
+    fn belief_sources(
+        slf: &Bound<'_, Self>,
+        node_id: u32,
+        observation_id: Option<&str>,
+        namespace: Option<&str>,
+    ) -> PyResult<PyObject> {
+        let obs = observation_id.map(|s| s.to_string());
+        let ns = namespace.map(|s| s.to_string());
+        let rows = Self::detached(slf, move |db| {
+            db.belief_sources(NodeId::from_raw(node_id), obs.as_deref(), ns.as_deref())
+        })?;
+        let out = PyList::empty(slf.py());
+        for r in &rows {
+            out.append(source_row_into(slf.py(), r)?)?;
+        }
+        Ok(out.into_any().unbind())
+    }
+
+    /// Reverse: which beliefs depend on this record? Works for retracted and
+    /// superseded sources too. `namespace` filters on the namespace the
+    /// citation was made in (the source record's, not the belief's — beliefs
+    /// carry no namespace).
+    #[pyo3(signature = (source_rid, namespace=None))]
+    fn beliefs_for_source(
+        slf: &Bound<'_, Self>,
+        source_rid: &str,
+        namespace: Option<&str>,
+    ) -> PyResult<PyObject> {
+        let rid = source_rid.to_string();
+        let ns = namespace.map(|s| s.to_string());
+        let rows = Self::detached(slf, move |db| {
+            db.beliefs_for_source(rid.as_str(), ns.as_deref())
+        })?;
+        let out = PyList::empty(slf.py());
+        for r in &rows {
+            out.append(source_row_into(slf.py(), r)?)?;
+        }
+        Ok(out.into_any().unbind())
