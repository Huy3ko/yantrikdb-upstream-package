+/// The guard must not swallow genuine evidence: a *different* record is a new
+/// observation even for the same belief.
+#[test]
+fn a_different_record_is_still_new_evidence() {
+    let db = open_db();
+    let b = belief(&db, "the count is 194");
+    let m1 = record_in(&db, "Method count: 194", "a");
+    let m2 = record_in(&db, "Second measurement: 194", "a");
