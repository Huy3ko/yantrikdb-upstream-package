+/// Parse the `sources` argument: a list of rid strings or of
+/// `{"rid": ..., "revision": n?}` dicts. A string means "the revision that is
+/// current when the citation is written".
+fn sources_from(items: Option<&Bound<'_, PyList>>) -> PyResult<Vec<EvidenceCitation>> {
+    let Some(list) = items else {
+        return Ok(Vec::new());
+    };
+    let mut out = Vec::with_capacity(list.len());
+    for item in list.iter() {
+        if let Ok(rid) = item.extract::<String>() {
+            out.push(EvidenceCitation { rid, revision: None });
+            continue;
+        }
+        let d = item.downcast::<PyDict>().map_err(|_| {
+            PyValueError::new_err("each source is a rid string or a dict {rid, revision?}")
+        })?;
+        let rid: String = d
+            .get_item("rid")?
+            .or(d.get_item("source_rid")?)
+            .ok_or_else(|| PyValueError::new_err("source needs 'rid'"))?
+            .extract()?;
+        let revision: Option<u32> = d
+            .get_item("revision")?
+            .filter(|v| !v.is_none())
+            .map(|v| v.extract::<u32>())
+            .transpose()?;
+        out.push(EvidenceCitation { rid, revision });
+    }
+    Ok(out)
+}
+
+fn source_row_into(py: Python<'_>, r: &BeliefSourceRow) -> PyResult<PyObject> {
+    let d = PyDict::new(py);
+    d.set_item("belief_id", r.belief_id)?;
+    d.set_item("proposition", &r.proposition)?;
+    d.set_item("observation_id", &r.observation_id)?;
+    d.set_item("source_rid", &r.source_rid)?;
+    d.set_item("source_revision", r.source_revision)?;
+    d.set_item("current_revision", r.current_revision)?;
+    d.set_item("revision_drift", r.revision_drift)?;
+    d.set_item("namespace", &r.namespace)?;
+    d.set_item("source_state", &r.source_state)?;
+    d.set_item("confidence", r.confidence)?;
+    d.set_item("cited_at", r.cited_at)?;
+    Ok(d.into_any().unbind())
+}
