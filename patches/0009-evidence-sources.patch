+// ── 9. Persistence across a process boundary ─────────────────────────
+
+#[test]
+fn provenance_survives_close_and_reopen() {
+    let dir = std::env::temp_dir().join(format!(
+        "ydb-provenance-{}-{:?}",
+        std::process::id(),
+        std::thread::current().id()
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("store.db");
+    let path_str = path.to_str().unwrap().to_string();
+
+    let (b, m, before) = {
+        let db = YantrikDB::new(&path_str, 8).unwrap();
+        let b = belief(&db, "survives");
+        let m = record_in(&db, "the record", "a");
+        db.assert_belief_evidence_with_sources(
+            &evidence_on(b, 2.0, "obs-persist"),
+            &[
+                EvidenceCitation { rid: m.clone(), revision: None },
+                EvidenceCitation { rid: record_in(&db, "second", "a"), revision: None },
+            ],
+            &cfg(),
+        )
+        .unwrap();
+        let p = probability(&db, b);
+        (b, m, p)
+    };
+
+    let db = YantrikDB::new(&path_str, 8).unwrap();
+    let fwd = db.belief_sources(b, None, None).unwrap();
+    assert_eq!(fwd.len(), 2, "citations are rows, not process state");
+    assert_eq!(fwd[0].observation_id, "obs-persist");
+    let rev = db.beliefs_for_source(&m, None).unwrap();
+    assert_eq!(rev.len(), 1);
+    let node = db.load_cognitive_node(b).unwrap().unwrap();
+    let crate::state::NodePayload::Belief(p) = &node.payload else { panic!() };
+    assert_eq!(p.evidence_trail.len(), 1);
+    assert!((p.probability() - before).abs() < 1e-12);
+    drop(db);
+    std::fs::remove_dir_all(&dir).ok();
+}
